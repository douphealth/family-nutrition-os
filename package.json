{
  "name": "zenith-pro-family-nutrition-os",
  "version": "13.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first, offline-first family nutrition PWA. No runtime dependencies.",
  "scripts": {
    "test": "node scripts/run_tests.mjs",
    "test:engine": "node tests/nutrition-engine.test.mjs",
    "test:data": "node tests/data-integrity.test.mjs",
    "test:provenance": "node tests/food-provenance.test.mjs",
    "test:menu": "node tests/menu.test.mjs",
    "test:reference": "node tests/reference.test.mjs",
    "test:persona": "node tests/persona.test.mjs",
    "test:dates": "node tests/dates.test.mjs && node tests/timezone-matrix.test.mjs",
    "smoke": "node scripts/smoke_dom.mjs && node scripts/smoke_dom.mjs --idb",
    "smoke:local": "node scripts/smoke_dom.mjs",
    "smoke:idb": "node scripts/smoke_dom.mjs --idb",
    "check": "node scripts/run_tests.mjs --check",
    "verify:pwa": "node scripts/verify_pwa.mjs",
    "verify": "npm run check && npm test && npm run verify:pwa && npm run smoke",
    "serve": "node scripts/serve.mjs",
    "data:usda": "node scripts/fetch_usda.mjs",
    "audit:a11y": "python scripts/audit_a11y.py",
    "audit:contrast": "python scripts/audit_contrast.py",
    "audit:layout": "python scripts/capture_mobile.py",
    "audit:selftest": "python scripts/verify_audit.py",
    "icons": "python scripts/gen_icons.py",
    "shots": "python scripts/capture_shots.py"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
